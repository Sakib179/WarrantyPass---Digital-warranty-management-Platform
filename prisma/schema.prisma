  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  customer        User             @relation(fields: [customerUserId], references: [id])

  @@index([customerUserId, createdAt])
  @@index([status, expiresAt])
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actorUserId  String?   @db.Uuid
  businessId   String?   @db.Uuid
  action       String    @db.VarChar(120)
  resourceType String    @db.VarChar(100)
  resourceId   String?   @db.Uuid
  requestId    String?   @db.VarChar(80)
  ipAddress    String?   @db.Inet
  userAgent    String?   @db.VarChar(500)
  /// Flexible, redacted event context; never store credentials, tokens, or document content.
  metadata     Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  actorUser    User?     @relation(fields: [actorUserId], references: [id])
  business     Business? @relation(fields: [businessId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([businessId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
}

model Session {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  /// Store only a one-way hash of the refresh token, never the raw token.
  refreshTokenHash String                @unique @db.Char(64)
  familyId         String                @db.Uuid
  rememberMe       Boolean               @default(false)
  ipAddress        String?               @db.Inet
  userAgent        String?               @db.VarChar(500)
  deviceName       String?               @db.VarChar(160)
  expiresAt        DateTime              @db.Timestamptz(3)
  lastUsedAt       DateTime?             @db.Timestamptz(3)
  revokedAt        DateTime?             @db.Timestamptz(3)
  revokedReason    String?               @db.VarChar(120)
  reuseDetectedAt  DateTime?             @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    SessionRefreshToken[]

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([revokedAt])
  @@index([lastUsedAt])
}

model SessionRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @db.Uuid
  tokenHash      String    @unique @db.Char(64)
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  replacedByHash String?   @db.Char(64)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

// ==================================================
// PART 7 & PART 8 DOMAIN MODELS
// ==================================================

enum ServiceCenterStatus {
  DRAFT
  ACTIVE
  TEMPORARILY_CLOSED
  INACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULE_REQUESTED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RepairStatus {
  CREATED
  PRODUCT_RECEIVED
  DIAGNOSIS_IN_PROGRESS
  WAITING_FOR_APPROVAL
  WAITING_FOR_PARTS
  REPAIR_IN_PROGRESS
  QUALITY_CHECK
  READY_FOR_COLLECTION
  DELIVERED
  COMPLETED
  CANCELLED
  UNREPAIRABLE
}

enum RepairCoverageStatus {
  FULLY_COVERED
  PARTIALLY_COVERED
  NOT_COVERED
  PENDING_DECISION
}

enum TransferStatus {
  DRAFT
  PENDING_RECIPIENT
  RECIPIENT_ACCEPTED
  RECIPIENT_REJECTED
  PENDING_BUSINESS_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RecallNoticeType {
  SAFETY_WARNING
  PRODUCT_RECALL
  FREE_REPLACEMENT
  SOFTWARE_UPDATE
  INSPECTION_REQUIRED
  SERVICE_CAMPAIGN
}

enum RecallSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecallStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  PAUSED
  CLOSED
  CANCELLED
}

model ServiceCenter {
  id                   String                       @id @default(uuid()) @db.Uuid
  businessId           String                       @db.Uuid
  name                 String                       @db.VarChar(160)
  serviceCenterCode    String                       @db.VarChar(50)
  phone                String                       @db.VarChar(40)
  email                String?                      @db.VarChar(254)
  addressLine          String                       @db.VarChar(255)
  area                 String                       @db.VarChar(100)
  district             String                       @db.VarChar(100)
  division             String                       @db.VarChar(100)
  postalCode           String?                      @db.VarChar(20)
  latitude             Float?
  longitude            Float?
  openingHours         String                       @db.Text
  serviceInstructions  String?                      @db.Text
  status               ServiceCenterStatus          @default(ACTIVE)
  createdByUserId      String                       @db.Uuid
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?                    @db.Timestamptz(3)
  business             Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser        User                         @relation("ServiceCenterCreator", fields: [createdByUserId], references: [id])
  supportedCategories  ServiceCenterCategory[]
  supportedBrands      ServiceCenterBrand[]
  members              ServiceCenterMember[]
  claimAssignments     ClaimServiceCenterAssignment[]
  appointments         ServiceAppointment[]
  repairs              RepairRecord[]

  @@unique([businessId, serviceCenterCode])
  @@index([businessId, status])
  @@index([division, district, area])
}

model ServiceCenterMember {
  id               String         @id @default(uuid()) @db.Uuid
  serviceCenterId  String         @db.Uuid
  businessMemberId String         @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  serviceCenter    ServiceCenter  @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  businessMember   BusinessMember @relation(fields: [businessMemberId], references: [id], onDelete: Cascade)

  @@unique([serviceCenterId, businessMemberId])
}

model ServiceCenterCategory {
  serviceCenterId   String          @db.Uuid
  productCategoryId String          @db.Uuid
  serviceCenter     ServiceCenter   @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@id([serviceCenterId, productCategoryId])
}

model ServiceCenterBrand {
  serviceCenterId String        @db.Uuid
  productBrandId  String        @db.Uuid
  serviceCenter   ServiceCenter @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  productBrand    ProductBrand  @relation(fields: [productBrandId], references: [id], onDelete: Cascade)

  @@id([serviceCenterId, productBrandId])
}

model ClaimServiceCenterAssignment {
  id               String        @id @default(uuid()) @db.Uuid
  claimId          String        @db.Uuid
  serviceCenterId  String        @db.Uuid
  assignedByUserId String        @db.Uuid
  assignedAt       DateTime      @default(now()) @db.Timestamptz(3)
  unassignedAt     DateTime?     @db.Timestamptz(3)
  assignmentReason String?       @db.Text
  claim            WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  serviceCenter    ServiceCenter @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  assignedByUser   User          @relation(fields: [assignedByUserId], references: [id])

  @@index([claimId, assignedAt])
}

model ServiceAppointment {
  id                  String            @id @default(uuid()) @db.Uuid
  claimId             String            @db.Uuid
  customerUserId      String            @db.Uuid
  serviceCenterId     String            @db.Uuid
  requestedDate       DateTime          @db.Date
  requestedTimeWindow String            @db.VarChar(60)
  confirmedDate       DateTime?         @db.Date
  confirmedTimeWindow String?           @db.VarChar(60)
  status              AppointmentStatus @default(REQUESTED)
  customerNote        String?           @db.Text
  businessNote        String?           @db.Text
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  claim               WarrantyClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  customer            User              @relation(fields: [customerUserId], references: [id])
  serviceCenter       ServiceCenter     @relation(fields: [serviceCenterId], references: [id])

  @@index([claimId])
  @@index([customerUserId])
  @@index([serviceCenterId, requestedDate])
}

model RepairRecord {
  id                     String                    @id @default(uuid()) @db.Uuid
  repairNumber           String                    @unique @db.VarChar(60)
  customerProductId      String                    @db.Uuid
  warrantyId             String?                   @db.Uuid
  claimId                String?                   @db.Uuid
  businessId             String                    @db.Uuid
  serviceCenterId        String                    @db.Uuid
  technicianMemberId     String?                   @db.Uuid
  reportedProblem        String                    @db.Text
  diagnosis              String?                   @db.Text
  workPerformed          String?                   @db.Text
  partsReplaced          String?                   @db.Text
  warrantyCoverageStatus RepairCoverageStatus      @default(PENDING_DECISION)
  laborCostCents         Int                       @default(0)
  partsCostCents         Int                       @default(0)
  totalCostCents         Int                       @default(0)
  receivedAt             DateTime?                 @db.Timestamptz(3)
  repairStartedAt        DateTime?                 @db.Timestamptz(3)
  completedAt            DateTime?                 @db.Timestamptz(3)
  deliveredAt            DateTime?                 @db.Timestamptz(3)
  currentStatus          RepairStatus              @default(CREATED)
  customerVisibleNote    String?                   @db.Text
  internalNote           String?                   @db.Text
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @db.Timestamptz(3)
  customerProduct        CustomerProduct           @relation(fields: [customerProductId], references: [id])
  warranty               Warranty?                 @relation(fields: [warrantyId], references: [id])
  claim                  WarrantyClaim?            @relation(fields: [claimId], references: [id])
  business               Business                  @relation(fields: [businessId], references: [id])
  serviceCenter          ServiceCenter             @relation(fields: [serviceCenterId], references: [id])
  technician             BusinessMember?           @relation(fields: [technicianMemberId], references: [id])
  statusHistory          RepairStatusHistory[]
  documents              RepairDocument[]
  assignmentHistory      RepairAssignmentHistory[]

  @@index([businessId, currentStatus])
  @@index([customerProductId])
  @@index([serviceCenterId])
}

model RepairStatusHistory {
  id                  String        @id @default(uuid()) @db.Uuid
  repairId            String        @db.Uuid
  fromStatus          RepairStatus?
  toStatus            RepairStatus
  changedByUserId     String        @db.Uuid
  customerVisibleNote String?       @db.Text
  internalNote        String?       @db.Text
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  repair              RepairRecord  @relation(fields: [repairId], references: [id], onDelete: Cascade)
  changedByUser       User          @relation(fields: [changedByUserId], references: [id])

  @@index([repairId, createdAt])
}

model RepairDocument {
  id                String       @id @default(uuid()) @db.Uuid
  repairId          String       @db.Uuid
  storageKey        String       @db.VarChar(255)
  originalName      String       @db.VarChar(255)
  mimeType          String       @db.VarChar(100)
  sizeBytes         Int
  isCustomerVisible Boolean      @default(true)
  uploadedByUserId  String       @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  repair            RepairRecord @relation(fields: [repairId], references: [id], onDelete: Cascade)
  uploadedByUser    User         @relation(fields: [uploadedByUserId], references: [id])

  @@index([repairId])
}

model RepairAssignmentHistory {
  id                   String          @id @default(uuid()) @db.Uuid
  repairId             String          @db.Uuid
  previousTechnicianId String?         @db.Uuid
  newTechnicianId      String?         @db.Uuid
  assignedByUserId     String          @db.Uuid
  assignedAt           DateTime        @default(now()) @db.Timestamptz(3)
  repair               RepairRecord    @relation(fields: [repairId], references: [id], onDelete: Cascade)
  previousTechnician   BusinessMember? @relation("PrevTech", fields: [previousTechnicianId], references: [id])
  newTechnician        BusinessMember? @relation("NewTech", fields: [newTechnicianId], references: [id])
  assignedByUser       User            @relation(fields: [assignedByUserId], references: [id])

  @@index([repairId, assignedAt])
}

model BusinessTransferPolicy {
  id                           String   @id @default(uuid()) @db.Uuid
  businessId                   String   @unique @db.Uuid
  isTransferAllowed            Boolean  @default(true)
  requireBusinessApproval      Boolean  @default(true)
  maxTransfersPerWarranty      Int      @default(3)
  minRemainingDaysRequired     Int      @default(30)
  transferRepairHistoryAllowed Boolean  @default(true)
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @db.Timestamptz(3)
  business                     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model OwnershipTransfer {
  id                  String                    @id @default(uuid()) @db.Uuid
  transferNumber      String                    @unique @db.VarChar(60)
  customerProductId   String                    @db.Uuid
  warrantyId          String                    @db.Uuid
  businessId          String                    @db.Uuid
  senderUserId        String                    @db.Uuid
  recipientEmail      String                    @db.VarChar(254)
  recipientUserId     String?                   @db.Uuid
  invitationTokenHash String                    @unique @db.Char(64)
  status              TransferStatus            @default(PENDING_RECIPIENT)
  rejectionReason     String?                   @db.Text
  expiresAt           DateTime                  @db.Timestamptz(3)
  acceptedAt          DateTime?                 @db.Timestamptz(3)
  businessApprovedAt  DateTime?                 @db.Timestamptz(3)
  businessApprovedBy  String?                   @db.Uuid
  completedAt         DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  customerProduct     CustomerProduct           @relation(fields: [customerProductId], references: [id])
  warranty            Warranty                  @relation(fields: [warrantyId], references: [id])
  business            Business                  @relation(fields: [businessId], references: [id])
  sender              User                      @relation("TransferSender", fields: [senderUserId], references: [id])
  recipient           User?                     @relation("TransferRecipient", fields: [recipientUserId], references: [id])
  approvedByMember    BusinessMember?           @relation(fields: [businessApprovedBy], references: [id])
  statusHistory       OwnershipTransferHistory[]
  ownershipHistories  ProductOwnershipHistory[]

  @@index([senderUserId])
  @@index([recipientEmail])
  @@index([businessId, status])
}

model OwnershipTransferHistory {
  id              String            @id @default(uuid()) @db.Uuid
  transferId      String            @db.Uuid
  fromStatus      TransferStatus?
  toStatus        TransferStatus
  changedByUserId String            @db.Uuid
  note            String?           @db.Text
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  transfer        OwnershipTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  changedByUser   User              @relation(fields: [changedByUserId], references: [id])

  @@index([transferId, createdAt])
}

model ProductOwnershipHistory {
  id                String            @id @default(uuid()) @db.Uuid
  customerProductId String            @db.Uuid
  previousOwnerId   String?           @db.Uuid
  newOwnerId        String            @db.Uuid
  transferId        String?           @db.Uuid
  transferredAt     DateTime          @default(now()) @db.Timestamptz(3)
  customerProduct   CustomerProduct   @relation(fields: [customerProductId], references: [id], onDelete: Cascade)
  previousOwner     User?             @relation("PrevOwner", fields: [previousOwnerId], references: [id])
  newOwner          User              @relation("NewOwner", fields: [newOwnerId], references: [id])
  transfer          OwnershipTransfer? @relation(fields: [transferId], references: [id])

  @@index([customerProductId, transferredAt])
}

model WarrantyVerificationAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  warrantyNumber    String   @db.VarChar(60)
  serialNumber      String?  @db.VarChar(100)
  verificationCode  String?  @db.VarChar(60)
  ipAddress         String?  @db.Inet
  userAgent         String?  @db.VarChar(500)
  result            String   @db.VarChar(40)
  matchedWarrantyId String?  @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([warrantyNumber])
  @@index([ipAddress, createdAt])
}

model RecallNotice {
  id                         String                  @id @default(uuid()) @db.Uuid
  businessId                 String                  @db.Uuid
  title                      String                  @db.VarChar(200)
  publicReferenceNumber      String                  @unique @db.VarChar(60)
  severity                   RecallSeverity          @default(MEDIUM)
  noticeType                 RecallNoticeType        @default(SAFETY_WARNING)
  description                String                  @db.Text
  customerInstructions       String                  @db.Text
  affectedBrandId            String?                 @db.Uuid
  affectedModelNumbers       String[]                @db.VarChar(100)
  affectedSerialNumberRanges String?                 @db.Text
  affectedPurchaseStart      DateTime?               @db.Date
  affectedPurchaseEnd        DateTime?               @db.Date
  publishedAt                DateTime?               @db.Timestamptz(3)
  expiresAt                  DateTime?               @db.Timestamptz(3)
  status                     RecallStatus            @default(DRAFT)
  createdByUserId            String                  @db.Uuid
  approvedByUserId           String?                 @db.Uuid
  createdAt                  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(3)
  business                   Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  affectedBrand              ProductBrand?           @relation(fields: [affectedBrandId], references: [id])
  createdByUser              User                    @relation("RecallCreator", fields: [createdByUserId], references: [id])
  approvedByUser             User?                   @relation("RecallApprover", fields: [approvedByUserId], references: [id])
  recipients                 RecallRecipient[]
  acknowledgements           RecallAcknowledgement[]

  @@index([businessId, status])
  @@index([publicReferenceNumber])
}

model RecallRecipient {
  id                String          @id @default(uuid()) @db.Uuid
  recallNoticeId    String          @db.Uuid
  customerUserId    String          @db.Uuid
  customerProductId String          @db.Uuid
  notifiedAt        DateTime        @default(now()) @db.Timestamptz(3)
  recallNotice      RecallNotice    @relation(fields: [recallNoticeId], references: [id], onDelete: Cascade)
  customer          User            @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  customerProduct   CustomerProduct @relation(fields: [customerProductId], references: [id], onDelete: Cascade)

  @@unique([recallNoticeId, customerUserId, customerProductId])
  @@index([customerUserId])
}

model RecallAcknowledgement {
  id             String       @id @default(uuid()) @db.Uuid
  recallNoticeId String       @db.Uuid
  customerUserId String       @db.Uuid
  acknowledgedAt DateTime     @default(now()) @db.Timestamptz(3)
  notes          String?      @db.Text
  recallNotice   RecallNotice @relation(fields: [recallNoticeId], references: [id], onDelete: Cascade)
  customer       User         @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@unique([recallNoticeId, customerUserId])
  @@index([customerUserId])
}

// ==================================================
// PART 9 & PART 10 SYSTEM & MANAGEMENT MODELS
// ==================================================

model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  attemptCount   Int                 @default(0)
  errorDetails   String?             @db.Text
  deliveredAt    DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel])
  @@index([status, createdAt])
}

model NotificationPreference {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @db.Uuid
  inAppEnabled           Boolean  @default(true)
  emailEnabled           Boolean  @default(true)
  claimUpdatesEnabled    Boolean  @default(true)
  repairUpdatesEnabled   Boolean  @default(true)
  transferUpdatesEnabled  Boolean  @default(true)
  businessUpdatesEnabled Boolean  @default(true)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityEvent {
  id             String                @id @default(uuid()) @db.Uuid
  type           String                @db.VarChar(120)
  severity       SecurityEventSeverity @default(MEDIUM)
  actorUserId    String?               @db.Uuid
  businessId     String?               @db.Uuid
  requestId      String?               @db.VarChar(80)
  ipAddress      String?               @db.Inet
  userAgent      String?               @db.VarChar(500)
  metadata       Json?
  detectedAt     DateTime              @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?             @db.Timestamptz(3)
  resolutionNote String?               @db.Text
  actorUser      User?                 @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  business       Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([type, detectedAt])
  @@index([severity, detectedAt])
  @@index([actorUserId, detectedAt])
  @@index([businessId, detectedAt])
}

model PrivacyRequest {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @db.Uuid
  requestType       PrivacyRequestType
  status            PrivacyRequestStatus @default(REQUESTED)
  downloadUrl       String?              @db.VarChar(500)
  downloadExpiresAt DateTime?            @db.Timestamptz(3)
  rejectionReason   String?              @db.Text
  requestedAt       DateTime             @default(now()) @db.Timestamptz(3)
  processedAt       DateTime?            @db.Timestamptz(3)
  completedAt       DateTime?            @db.Timestamptz(3)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, requestedAt])
}

model SystemSetting {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique @db.VarChar(100)
  value           Json
  description     String?  @db.Text
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  updatedByUser   User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model FeatureFlag {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique @db.VarChar(100)
  isEnabled       Boolean  @default(true)
  description     String?  @db.Text
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  updatedByUser   User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model BackgroundJob {
  id             String              @id @default(uuid()) @db.Uuid
  queueName      String              @db.VarChar(100)
  jobName        String              @db.VarChar(120)
  payload        Json
  status         BackgroundJobStatus @default(PENDING)
  attemptCount   Int                 @default(0)
  maxRetries     Int                 @default(5)
  errorDetails   String?             @db.Text
  idempotencyKey String?             @unique @db.VarChar(180)
  scheduledAt    DateTime            @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?           @db.Timestamptz(3)
  failedAt       DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  @@index([queueName, status, scheduledAt])
  @@index([status, createdAt])
}


