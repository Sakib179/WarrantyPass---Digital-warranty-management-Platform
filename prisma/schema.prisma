generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  CUSTOMER
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

enum BusinessStatus {
  DRAFT
  PENDING
  IN_REVIEW
  MORE_INFORMATION_REQUIRED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum BusinessRegistrationType {
  TRADE_LICENSE
  BIN
  OTHER
}

enum VerificationStatus {
  DRAFT
  PENDING
  IN_REVIEW
  MORE_INFORMATION_REQUIRED
  VERIFIED
  APPROVED
  REJECTED
  NEEDS_INFORMATION
  SUSPENDED
  DEACTIVATED
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum VerificationRevisionStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED
}

enum VerificationDocumentKind {
  TRADE_LICENSE
  BIN
  SUPPORTING
}

enum FileScanStatus {
  UPLOADED
  PENDING_SCAN
  SAFE
  REJECTED
  DELETED
}

enum PlatformRoleStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WarrantySource {
  BUSINESS_ISSUED
  USER_UPLOADED
  PLATFORM_IMPORTED
}

enum WarrantyStatus {
  DRAFT
  NOT_STARTED
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  INVALID
  REVOKED
  VOIDED
}

enum WarrantyVerificationLabel {
  VERIFIED_BY_BUSINESS
  USER_UPLOADED
  VERIFICATION_PENDING
  UNVERIFIED
  REJECTED
  EXPIRED
  INVALID
  REVOKED
}

enum CustomerProductSource {
  BUSINESS_ISSUED
  USER_UPLOADED
  PLATFORM_IMPORTED
}

enum ProductOwnershipStatus {
  ACTIVE
  ARCHIVED
  TRANSFERRED
}

enum WarrantyDurationUnit {
  DAYS
  MONTHS
  YEARS
}

enum WarrantyCoverageType {
  MANUFACTURER
  SELLER
  LIMITED
  EXTENDED
  SERVICE_ONLY
  OTHER
}

enum ExtractionStatus {
  PENDING
  COMPLETED
  CONFIRMED
  FAILED
  EXPIRED
}

enum DocumentKind {
  WARRANTY_CARD
  WARRANTY_PAPER
  INVOICE
  RECEIPT
  BUSINESS_VERIFICATION
  CLAIM_EVIDENCE
  REPAIR_RECEIPT
  PRODUCT_IMAGE
  OTHER
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INFORMATION_REQUIRED
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  ASSIGNED
  PRODUCT_RECEIVED
  IN_SERVICE
  IN_PROGRESS
  READY_FOR_COLLECTION
  RESOLVED
  CLOSED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MessageSenderType {
  CUSTOMER
  BUSINESS_EMPLOYEE
  SYSTEM
}




enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum SubscriptionOwnerType {
  USER
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BillingEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  RETRYING
  CANCELLED
}

enum PrivacyRequestType {
  EXPORT_DATA
  DELETE_ACCOUNT
  DEACTIVATE_ACCOUNT
}

enum PrivacyRequestStatus {
  REQUESTED
  UNDER_REVIEW
  SCHEDULED
  COMPLETED
  REJECTED
  CANCELLED
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SecurityEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                             String                              @id @default(uuid()) @db.Uuid
  email                          String                              @unique @db.VarChar(254)
  passwordHash                   String?                             @db.VarChar(255)
  kind                           UserKind                            @default(CUSTOMER)
  status                         UserStatus                          @default(PENDING)
  emailVerifiedAt                DateTime?                           @db.Timestamptz(3)
  passwordChangedAt              DateTime?                           @db.Timestamptz(3)
  lastLoginAt                    DateTime?                           @db.Timestamptz(3)
  failedLoginCount               Int                                 @default(0)
  lockedUntil                    DateTime?                           @db.Timestamptz(3)
  lastActiveBusinessId           String?                             @db.Uuid
  createdAt                      DateTime                            @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                            @updatedAt @db.Timestamptz(3)
  deletedAt                      DateTime?                           @db.Timestamptz(3)
  profile                        UserProfile?
  lastActiveBusiness             Business?                           @relation("LastActiveBusiness", fields: [lastActiveBusinessId], references: [id])
  businessMemberships            BusinessMember[]
  submittedVerifications         BusinessVerification[]              @relation("VerificationSubmitter")
  reviewedVerifications          BusinessVerification[]              @relation("VerificationReviewer")
  claimedVerifications           BusinessVerification[]              @relation("VerificationClaimer")
  submittedVerificationRevisions BusinessVerificationRevision[]      @relation("VerificationRevisionSubmitter")
  reviewedVerificationStatuses   BusinessVerificationStatusHistory[] @relation("VerificationStatusReviewer")
  uploadedVerificationDocuments  BusinessVerificationDocument[]      @relation("VerificationDocumentUploader")
  businessesVerified             Business[]                          @relation("BusinessVerifier")
  invitationsSent                BusinessInvitation[]                @relation("InvitationSender")
  invitationsAccepted            BusinessInvitation[]                @relation("InvitationAcceptor")
  membersInvited                 BusinessMember[]                    @relation("MemberInviter")
  emailVerificationTokens        EmailVerificationToken[]
  passwordResetTokens            PasswordResetToken[]
  emailChangeTokens              EmailChangeToken[]
  loginAttempts                  LoginAttempt[]
  termsAcceptances               TermsAcceptance[]
  platformRoles                  UserPlatformRole[]
  ownedProducts                  Product[]
  customerProducts               CustomerProduct[]
  warranties                     Warranty[]                          @relation("WarrantyCustomer")
  revokedWarranties              Warranty[]                          @relation("WarrantyRevoker")
  submittedClaims                WarrantyClaim[]                     @relation("ClaimSubmitter")
  createdCatalogProducts         CatalogProduct[]                    @relation("CatalogProductCreator")
  createdTemplates               WarrantyTemplate[]                  @relation("TemplateCreator")
  warrantyRevisions              WarrantyRevision[]
  uploadedClaimAttachments       ClaimAttachment[]
  sentClaimMessages              ClaimMessage[]
  assignedClaimHistories         ClaimAssignmentHistory[]            @relation("ClaimAssigner")
  sentTransfers                  OwnershipTransfer[]                 @relation("TransferSender")
  receivedTransfers              OwnershipTransfer[]                 @relation("TransferRecipient")
  createdServiceCenters          ServiceCenter[]                     @relation("ServiceCenterCreator")
  assignedClaimCenterAssignments ClaimServiceCenterAssignment[]
  serviceAppointments            ServiceAppointment[]
  changedRepairStatuses          RepairStatusHistory[]
  uploadedRepairDocuments        RepairDocument[]
  assignedRepairHistories        RepairAssignmentHistory[]
  ownershipTransferHistories     OwnershipTransferHistory[]
  previousProductOwnerships      ProductOwnershipHistory[]           @relation("PrevOwner")
  newProductOwnerships           ProductOwnershipHistory[]           @relation("NewOwner")
  createdRecallNotices           RecallNotice[]                      @relation("RecallCreator")
  approvedRecallNotices          RecallNotice[]                      @relation("RecallApprover")
  recallRecipients               RecallRecipient[]
  recallAcknowledgements         RecallAcknowledgement[]
  notifications                  Notification[]
  notificationPreference         NotificationPreference?
  subscriptions                  Subscription[]
  extractionJobs                 DocumentExtractionJob[]
  auditLogs                      AuditLog[]
  sessions                       Session[]
  warrantyDocuments              WarrantyDocument[]
  securityEvents                 SecurityEvent[]
  privacyRequests                PrivacyRequest[]
  updatedSettings                SystemSetting[]
  updatedFeatureFlags            FeatureFlag[]

  @@index([kind, status])
  @@index([email])
  @@index([lockedUntil])
  @@index([lastActiveBusinessId])
  @@index([createdAt])
  @@index([deletedAt])
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String?  @db.VarChar(120)
  phone       String?  @unique @db.VarChar(32)
  locale      String   @default("en-BD") @db.VarChar(16)
  timezone    String   @default("Asia/Dhaka") @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id                           String                              @id @default(uuid()) @db.Uuid
  name                         String                              @db.VarChar(160)
  legalName                    String?                             @db.VarChar(180)
  slug                         String                              @unique @db.VarChar(180)
  email                        String                              @db.VarChar(254)
  phone                        String?                             @db.VarChar(32)
  website                      String?                             @db.VarChar(300)
  businessType                 String?                             @db.VarChar(80)
  yearEstablished              Int?
  registrationType             BusinessRegistrationType
  registrationNumber           String                              @db.VarChar(80)
  registrationNumberNormalized String?                             @db.VarChar(80)
  binNumber                    String?                             @db.VarChar(80)
  binNumberNormalized          String?                             @db.VarChar(80)
  addressLine                  String?                             @db.VarChar(220)
  area                         String?                             @db.VarChar(120)
  district                     String?                             @db.VarChar(80)
  division                     String?                             @db.VarChar(80)
  postalCode                   String?                             @db.VarChar(20)
  status                       BusinessStatus                      @default(DRAFT)
  statusVersion                Int                                 @default(1)
  duplicateIdentifierFlag      Boolean                             @default(false)
  verificationReference        String?                             @unique @db.VarChar(40)
  verifiedAt                   DateTime?                           @db.Timestamptz(3)
  verifiedByUserId             String?                             @db.Uuid
  createdAt                    DateTime                            @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                            @updatedAt @db.Timestamptz(3)
  deletedAt                    DateTime?                           @db.Timestamptz(3)
  verifiedBy                   User?                               @relation("BusinessVerifier", fields: [verifiedByUserId], references: [id])
  lastActiveUsers              User[]                              @relation("LastActiveBusiness")
  verifications                BusinessVerification[]
  verificationRevisions        BusinessVerificationRevision[]
  verificationDocuments        BusinessVerificationDocument[]
  verificationStatusHistory    BusinessVerificationStatusHistory[]
  invitations                  BusinessInvitation[]
  members                      BusinessMember[]
  roles                        Role[]
  products                     Product[]
  catalogProducts              CatalogProduct[]
  warrantyTemplates            WarrantyTemplate[]
  issuedWarranties             Warranty[]
  claims                       WarrantyClaim[]
  serviceCenters               ServiceCenter[]
  repairRecords                RepairRecord[]
  transferPolicy               BusinessTransferPolicy?
  ownershipTransfers           OwnershipTransfer[]
  recallNotices                RecallNotice[]
  subscriptions                Subscription[]
  auditLogs                    AuditLog[]
  notifications                Notification[]
  securityEvents               SecurityEvent[]

  @@index([registrationType, registrationNumber])
  @@index([status])
  @@index([email])
  @@index([registrationNumberNormalized])
  @@index([binNumberNormalized])
  @@index([status, updatedAt])
  @@index([verifiedByUserId])
  @@index([deletedAt])
}

model BusinessVerification {
  id                 String             @id @default(uuid()) @db.Uuid
  businessId         String             @db.Uuid
  submittedByUserId  String             @db.Uuid
  reviewedByUserId   String?            @db.Uuid
  claimedByUserId    String?            @db.Uuid
  status             VerificationStatus @default(PENDING)
  referenceNumber    String?            @unique @db.VarChar(40)
  documentStorageKey String?            @db.VarChar(500)
  documentKind       String?            @db.VarChar(80)
  submittedNotes     String?            @db.Text
  reviewNotes        String?            @db.Text
  userVisibleReason  String?            @db.Text
  rejectionCategory  String?            @db.VarChar(80)
  claimedAt          DateTime?          @db.Timestamptz(3)
  submittedAt        DateTime           @default(now()) @db.Timestamptz(3)
  reviewedAt         DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  submittedBy        User               @relation("VerificationSubmitter", fields: [submittedByUserId], references: [id])
  reviewedBy         User?              @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id])
  claimedBy          User?              @relation("VerificationClaimer", fields: [claimedByUserId], references: [id])

  @@index([businessId, status])
  @@index([reviewedByUserId])
  @@index([claimedByUserId])
  @@index([status, submittedAt])
}

model BusinessMember {
  id              String          @id @default(uuid()) @db.Uuid
  businessId      String          @db.Uuid
  userId          String          @db.Uuid
  roleId          String          @db.Uuid
  invitedByUserId String?         @db.Uuid
  status          MemberStatus    @default(INVITED)
  invitedAt       DateTime        @default(now()) @db.Timestamptz(3)
  joinedAt        DateTime?       @db.Timestamptz(3)
  suspendedAt     DateTime?       @db.Timestamptz(3)
  removedAt       DateTime?       @db.Timestamptz(3)
  lastActiveAt    DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?       @db.Timestamptz(3)
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id])
  invitedBy       User?           @relation("MemberInviter", fields: [invitedByUserId], references: [id])
  roles           MemberRole[]
  assignedClaims          WarrantyClaim[]
  prevClaimAssignments    ClaimAssignmentHistory[] @relation("ClaimAssignmentPrev")
  newClaimAssignments     ClaimAssignmentHistory[] @relation("ClaimAssignmentNew")
  serviceCenterMemberships ServiceCenterMember[]
  repairedRecords         RepairRecord[]
  prevTechAssignmentHistory RepairAssignmentHistory[] @relation("PrevTech")
  newTechAssignmentHistory  RepairAssignmentHistory[] @relation("NewTech")
  approvedTransfers       OwnershipTransfer[]

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([roleId])
  @@index([invitedByUserId])
  @@index([businessId, status])
  @@index([deletedAt])
}

model Role {
  id          String               @id @default(uuid()) @db.Uuid
  businessId  String?              @db.Uuid
  key         String               @unique @db.VarChar(100)
  name        String               @db.VarChar(100)
  description String?              @db.VarChar(300)
  isSystem    Boolean              @default(false)
  isProtected Boolean              @default(false)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?            @db.Timestamptz(3)
  business    Business?            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members     BusinessMember[]
  memberRoles MemberRole[]
  invitations BusinessInvitation[]
  permissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([deletedAt])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String           @db.VarChar(300)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MemberRole {
  memberId   String         @db.Uuid
  roleId     String         @db.Uuid
  assignedBy String?        @db.Uuid
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  member     BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role       Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([memberId, roleId])
  @@index([roleId])
}

model EmailVerificationToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model PasswordResetToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model EmailChangeToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  newEmail      String    @db.VarChar(254)
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([newEmail])
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  emailHash     String   @db.Char(64)
  succeeded     Boolean
  failureReason String?  @db.VarChar(80)
  requestId     String?  @db.VarChar(80)
  ipAddress     String?  @db.Inet
  userAgent     String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([emailHash, createdAt])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
}

model TermsAcceptance {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  termsVersion      String   @db.VarChar(40)
  privacyVersion    String   @db.VarChar(40)
  termsAcceptedAt   DateTime @db.Timestamptz(3)
  privacyAcceptedAt DateTime @db.Timestamptz(3)
  ipAddress         String?  @db.Inet
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BusinessVerificationRevision {
  id                           String                         @id @default(uuid()) @db.Uuid
  businessId                   String                         @db.Uuid
  submittedByUserId            String                         @db.Uuid
  version                      Int
  status                       VerificationRevisionStatus     @default(DRAFT)
  ownerFullName                String                         @db.VarChar(120)
  legalName                    String                         @db.VarChar(180)
  displayName                  String                         @db.VarChar(160)
  businessType                 String                         @db.VarChar(80)
  tradeLicenseNumber           String                         @db.VarChar(80)
  tradeLicenseNumberNormalized String                         @db.VarChar(80)
  binNumber                    String?                        @db.VarChar(80)
  binNumberNormalized          String?                        @db.VarChar(80)
  yearEstablished              Int?
  phone                        String                         @db.VarChar(32)
  businessEmail                String                         @db.VarChar(254)
  website                      String?                        @db.VarChar(300)
  addressLine                  String                         @db.VarChar(220)
  area                         String                         @db.VarChar(120)
  district                     String                         @db.VarChar(80)
  division                     String                         @db.VarChar(80)
  postalCode                   String?                        @db.VarChar(20)
  submittedAt                  DateTime?                      @db.Timestamptz(3)
  createdAt                    DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                       @updatedAt @db.Timestamptz(3)
  business                     Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  submittedBy                  User                           @relation("VerificationRevisionSubmitter", fields: [submittedByUserId], references: [id])
  documents                    BusinessVerificationDocument[]

  @@unique([businessId, version])
  @@index([businessId, status])
  @@index([submittedByUserId])
  @@index([tradeLicenseNumberNormalized])
  @@index([binNumberNormalized])
}

model BusinessVerificationDocument {
  id               String                       @id @default(uuid()) @db.Uuid
  businessId       String                       @db.Uuid
  revisionId       String                       @db.Uuid
  uploadedByUserId String                       @db.Uuid
  kind             VerificationDocumentKind
  storageKey       String                       @unique @db.VarChar(500)
  displayName      String                       @db.VarChar(255)
  originalName     String                       @db.VarChar(255)
  mimeType         String                       @db.VarChar(100)
  sizeBytes        Int
  checksumSha256   String                       @db.Char(64)
  scanStatus       FileScanStatus               @default(PENDING_SCAN)
  scannedAt        DateTime?                    @db.Timestamptz(3)
  deletedAt        DateTime?                    @db.Timestamptz(3)
  createdAt        DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                     @updatedAt @db.Timestamptz(3)
  business         Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  revision         BusinessVerificationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  uploadedBy       User                         @relation("VerificationDocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([businessId, kind])
  @@index([revisionId, deletedAt])
  @@index([scanStatus])
}

model BusinessVerificationStatusHistory {
  id                String          @id @default(uuid()) @db.Uuid
  businessId        String          @db.Uuid
  previousStatus    BusinessStatus?
  newStatus         BusinessStatus
  reviewerId        String?         @db.Uuid
  internalNote      String?         @db.Text
  userVisibleReason String?         @db.Text
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer          User?           @relation("VerificationStatusReviewer", fields: [reviewerId], references: [id])

  @@index([businessId, createdAt])
  @@index([newStatus, createdAt])
  @@index([reviewerId])
}

model BusinessInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  businessId       String           @db.Uuid
  roleId           String           @db.Uuid
  invitedByUserId  String           @db.Uuid
  acceptedByUserId String?          @db.Uuid
  email            String           @db.VarChar(254)
  tokenHash        String           @unique @db.Char(64)
  personalMessage  String?          @db.VarChar(500)
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @db.Timestamptz(3)
  acceptedAt       DateTime?        @db.Timestamptz(3)
  revokedAt        DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role             Role             @relation(fields: [roleId], references: [id])
  invitedBy        User             @relation("InvitationSender", fields: [invitedByUserId], references: [id])
  acceptedBy       User?            @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([businessId, status, createdAt])
  @@index([email, status])
