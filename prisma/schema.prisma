  customerProduct    CustomerProduct?          @relation(fields: [customerProductId], references: [id])
  issuerBusiness     Business?                 @relation(fields: [issuerBusinessId], references: [id])
  template           WarrantyTemplate?         @relation(fields: [templateId], references: [id])
