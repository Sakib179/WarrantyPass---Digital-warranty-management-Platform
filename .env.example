# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AUTH_CSRF_COOKIE_NAME=wp_csrf
APP_VERSION=0.4.0
LOG_LEVEL=debug

# PostgreSQL (development example only)
POSTGRES_DB=warrantypass
POSTGRES_USER=warrantypass
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://warrantypass:replace-with-a-local-only-password@localhost:5432/warrantypass

# Comma-separated exact origins; wildcards are intentionally unsupported
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_STORE=memory
REDIS_URL=
JSON_BODY_LIMIT=1mb

# Authentication and secure sessions
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-random-access-secret-at-least-32-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_REMEMBER_ME_EXPIRES_IN=30d
AUTH_COOKIE_NAME=wp_refresh
AUTH_CSRF_COOKIE_NAME=wp_csrf
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=strict
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m

# Argon2id and single-use token policies
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=1
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
INVITATION_EXPIRES_IN=7d
TERMS_VERSION=2026-08-01
PRIVACY_VERSION=2026-08-01

# Email (Mailpit defaults for local development)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@warrantypass.local
SMTP_FROM_NAME=WarrantyPass
MAILPIT_WEB_URL=http://localhost:8025

# File storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
VERIFICATION_DOCUMENT_MAX_BYTES=10485760
WARRANTY_DOCUMENT_MAX_BYTES=10485760
WARRANTY_EXPIRING_SOON_DAYS=30
DOCUMENT_EXTRACTION_PROVIDER=mock
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-at-least-32-characters
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Development-only platform accounts. Do not define production passwords in files.
PLATFORM_ADMIN_EMAIL=dev.admin@warrantypass.local
PLATFORM_ADMIN_PASSWORD=
PLATFORM_REVIEWER_EMAIL=dev.reviewer@warrantypass.local
PLATFORM_REVIEWER_PASSWORD=
DEV_SEED_PASSWORD=

# Optional isolated integration database
TEST_DATABASE_URL=

# Optional database administration UI (Docker Compose profile: tools)
PGADMIN_DEFAULT_EMAIL=admin@localhost.test
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-only-password
